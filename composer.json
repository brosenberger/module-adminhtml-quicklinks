        "adminhtml",
        "admin",
        "favorites",
        "bookmarks",
        "quick-links",
        "usability",
        "brocode"
    ],
    "authors": [
        {
            "name": "Benjamin Rosenberger",
            "email": "bensch.rosenberger@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/brosenberger/module-adminhtml-quicklinks/issues",
        "source": "https://github.com/brosenberger/module-adminhtml-quicklinks"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/brosenberger"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": ">=103.0.0",
        "magento/module-backend": ">=102.0.0",
        "magento/module-user": ">=101.2.0"
    },
    "autoload": {
