            <tbody data-role="empty"<?= $links === [] ? '' : ' hidden' ?>>
                <tr class="data-grid-tr-no-data">
                    <td colspan="5"><?= $escaper->escapeHtml(__('You have no quick links yet.')) ?></td>
                </tr>
            </tbody>
        </table>
    </div>

    <form class="brocode-ql-add" data-role="add-form" novalidate>
        <h2 class="brocode-ql-add-title"><?= $escaper->escapeHtml(__('Add a custom link')) ?></h2>
        <div class="brocode-ql-add-fields">
            <input type="text" class="admin__control-text" name="label" maxlength="255" required
                   placeholder="<?= $escaper->escapeHtmlAttr(__('Label')) ?>"
                   aria-label="<?= $escaper->escapeHtmlAttr(__('Label')) ?>"/>
            <input type="url" class="admin__control-text" name="url" maxlength="2048" required
                   placeholder="https://"
                   aria-label="<?= $escaper->escapeHtmlAttr(__('URL')) ?>"/>
            <button type="submit" class="action-primary"><?= $escaper->escapeHtml(__('Add link')) ?></button>
        </div>
        <p class="brocode-ql-note">
            <?= $escaper->escapeHtml(__('Paste any admin URL or an external http(s) link. Admin URLs are stored without their session key and keep working after you log in again.')) ?>
        </p>
    </form>
</div>
