                                    <?= $escaper->escapeHtml(__('Save')) ?>
                                </button>
                                <button type="button" class="action-default" data-action="cancel-edit">
                                    <?= $escaper->escapeHtml(__('Cancel')) ?>
                                </button>
                            </div>
                        </td>
                        <td class="brocode-ql-col-pin">
                            <input type="checkbox" class="admin__control-checkbox" data-action="pin"
                                   id="brocode-ql-pin-<?= (int)$link->getLinkId() ?>"
                                <?= $link->isPinned() ? ' checked' : '' ?>/>
                            <label class="admin__field-label" for="brocode-ql-pin-<?= (int)$link->getLinkId() ?>">
                                <span class="brocode-quicklinks-sr"><?= $escaper->escapeHtml(__('Show in header')) ?></span>
                            </label>
                        </td>
                        <td class="brocode-ql-col-actions">
                            <button type="button" class="action-default" data-action="edit">
                                <?= $escaper->escapeHtml(__('Edit')) ?>
                            </button>
                            <button type="button" class="action-default" data-action="delete">
                                <?= $escaper->escapeHtml(__('Delete')) ?>
                            </button>
                        </td>
                    </tr>
                <?php endforeach; ?>
