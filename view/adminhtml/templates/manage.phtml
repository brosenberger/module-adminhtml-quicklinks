/** @var \BroCode\AdminhtmlQuickLinks\Block\Adminhtml\Manage $block */
/** @var \Magento\Framework\Escaper $escaper */

$links = $block->getLinks();
$widgetInit = '{"BroCode_AdminhtmlQuickLinks/js/manage":' . $block->getWidgetConfigJson() . '}';
?>
<div class="brocode-ql-manage" data-mage-init="<?= $escaper->escapeHtmlAttr($widgetInit) ?>">
    <p class="brocode-ql-intro">
        <?= $escaper->escapeHtml(__('Click the star in the admin header on any page to add it here. Pinned links show as buttons in the header, the others in the star dropdown. Drag a row, or use the arrows, to change the order.')) ?>
    </p>

    <div class="admin__data-grid-wrap admin__data-grid-wrap-static brocode-ql-grid">
        <table class="data-grid">
            <thead>
                <tr>
                    <th class="data-grid-th data-grid-draggable-row-cell">
                        <span class="brocode-quicklinks-sr"><?= $escaper->escapeHtml(__('Drag to reorder')) ?></span>
                    </th>
                    <th class="data-grid-th brocode-ql-col-move"><?= $escaper->escapeHtml(__('Order')) ?></th>
                    <th class="data-grid-th brocode-ql-col-link"><?= $escaper->escapeHtml(__('Link')) ?></th>
                    <th class="data-grid-th brocode-ql-col-pin"><?= $escaper->escapeHtml(__('Show in header')) ?></th>
                    <th class="data-grid-th brocode-ql-col-actions"><?= $escaper->escapeHtml(__('Actions')) ?></th>
                </tr>
            </thead>
            <tbody data-role="quicklinks-list">
                <?php foreach ($links as $link): ?>
                    <tr class="data-row" data-link-id="<?= (int)$link->getLinkId() ?>"
                        data-external="<?= $link->isExternal() ? '1' : '0' ?>">
                        <td class="data-grid-draggable-row-cell">
                            <div class="draggable-handle" data-role="drag-handle"
                                 title="<?= $escaper->escapeHtmlAttr(__('Drag to reorder')) ?>"></div>
                        </td>
                        <td class="brocode-ql-col-move">
                            <span class="brocode-ql-move">
                                <button type="button" class="action-default" data-action="up"
                                        aria-label="<?= $escaper->escapeHtmlAttr(__('Move up')) ?>">&#9650;</button>
                                <button type="button" class="action-default" data-action="down"
                                        aria-label="<?= $escaper->escapeHtmlAttr(__('Move down')) ?>">&#9660;</button>
                            </span>
                        </td>
                        <td class="brocode-ql-col-link">
                            <div class="brocode-ql-view" data-role="view">
                                <a class="brocode-ql-label" data-role="label-link"
