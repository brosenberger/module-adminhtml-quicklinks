declare(strict_types=1);

/** @var \BroCode\AdminhtmlQuickLinks\Block\Adminhtml\Header\QuickLinks $block */
/** @var \Magento\Framework\Escaper $escaper */

$currentLinkId = $block->getCurrentLinkId();
$widgetInit = '{"BroCode_AdminhtmlQuickLinks/js/quicklinks-toggle":' . $block->getWidgetConfigJson() . '}';
?>
<div class="brocode-quicklinks admin__action-dropdown-wrap"
     data-mage-init="<?= $escaper->escapeHtmlAttr($widgetInit) ?>">
    <button type="button"
            class="brocode-quicklinks-star"
            data-role="quicklinks-star"
            aria-pressed="<?= $currentLinkId !== null ? 'true' : 'false' ?>"
            title="<?= $escaper->escapeHtmlAttr(__('Add or remove this page from your quick links')) ?>">
        <span class="brocode-quicklinks-star-icon" aria-hidden="true"></span>
        <span class="brocode-quicklinks-sr"><?= $escaper->escapeHtml(__('Quick link for this page')) ?></span>
    </button>
    <a href="<?= $escaper->escapeUrl($block->getManageUrl()) ?>"
       class="admin__action-dropdown brocode-quicklinks-more"
       title="<?= $escaper->escapeHtmlAttr(__('More quick links')) ?>"
       data-mage-init='{"dropdown":{}}'
       data-toggle="dropdown">
        <span class="brocode-quicklinks-sr"><?= $escaper->escapeHtml(__('More quick links')) ?></span>
    </a>
    <ul class="admin__action-dropdown-menu brocode-quicklinks-menu" data-role="quicklinks-overflow">
        <?php foreach ($block->getOverflowLinks() as $link): ?>
            <li class="brocode-quicklinks-item" data-link-id="<?= (int)$link->getLinkId() ?>">
                <a href="<?= $escaper->escapeUrl($block->getHref($link)) ?>"
                    <?php if ($link->isExternal()): ?>
                        class="_external" target="_blank" rel="noopener noreferrer"
                    <?php endif; ?>
                ><?= $escaper->escapeHtml($link->getLabel()) ?></a>
            </li>
        <?php endforeach; ?>
        <li class="brocode-quicklinks-manage">
            <a href="<?= $escaper->escapeUrl($block->getManageUrl()) ?>">
                <?= $escaper->escapeHtml(__('Manage quick links')) ?> &rarr;
            </a>
        </li>
    </ul>
</div>
